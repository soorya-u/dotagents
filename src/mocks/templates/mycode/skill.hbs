---
name: {{skill.name}}
description: {{skill.description}}
{{#if skill.license}}
license: {{skill.license}}
{{/if}}
{{#if skill.compatibility}}
compatibility: {{skill.compatibility}}
{{/if}}
{{#if skill.metadata}}
metadata:
{{#each skill.metadata}}
  {{@key}}: {{this}}
{{/each}}
{{/if}}
{{#if skill.[allowed-tools]}}
allowed-tools: {{skill.[allowed-tools]}}
{{/if}}
---

{{{skill.content}}}
