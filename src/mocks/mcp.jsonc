{
  "$schema": "https://dotagents.soorya-u.dev/json/schemas/mcp.schema.json",
  "servers": {
    "server-stdio": {
      "type": "stdio",
      "command": "python",
      "args": [],
      "cwd": "{{ dir.workspace }}",
      "env": {},
      "env_file": null,
    },
    "server-mcp": {
      "type": "http",
      "url": "http://localhost:9000",
      "headers": {
        "Authorization": "Bearer ${API_KEY}",
      },
    },
  },
}
