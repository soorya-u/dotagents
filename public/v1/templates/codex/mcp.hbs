{{#each mcp.servers}}
{{#ifEq this.type "http"}}
[mcp_servers.{{@key}}]
url = "{{this.url}}"
{{#if this.headers}}
[mcp_servers.{{@key}}.http_headers]
{{#each this.headers}}{{@key}} = "{{this}}"
{{/each}}
{{/if}}
{{else}}
[mcp_servers.{{@key}}]
command = "{{this.command}}"
args = {{json this.args}}
{{#if this.env}}
[mcp_servers.{{@key}}.env]
{{#each this.env}}{{@key}} = "{{this}}"
{{/each}}
{{/if}}
{{/ifEq}}
{{/each}}
