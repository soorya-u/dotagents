extensions:
{{#each mcp.servers}}
  {{@key}}:
    name: {{@key}}
    enabled: true
    timeout: 300
    bundled: false
    {{#ifEq this.type "http"}}
    type: streamable_http
    uri: {{json this.url}}
    {{else}}
    type: stdio
    cmd: {{json this.command}}
    args: {{json this.args}}
    {{#if this.env}}envs: {{json this.env}}{{/if}}
    {{/ifEq}}
{{/each}}
