{
  "mcpServers": {
    {{#each mcp.servers}}
    "{{@key}}": {
      {{#ifEq this.type "stdio"}}
      "type": "stdio",
      "command": "{{this.command}}",
      "args": {{json this.args}}{{#if this.env}},
      "env": {{json this.env}}{{/if}}{{#if this.cwd}},
      "cwd": {{json this.cwd}}{{/if}}{{#if this.envFile}},
      "env_file": {{json this.envFile}}{{/if}}
      {{else}}
      "type": "{{this.type}}",
      "url": "{{this.url}}"{{#if this.headers}},
      "headers": {{json this.headers}}{{/if}}
      {{/ifEq}}{{#if this.disabled}},
      "disabled": {{json this.disabled}}{{/if}}{{#if this.disabledTools}},
      "disabledTools": {{json this.disabledTools}}{{/if}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  }
}
