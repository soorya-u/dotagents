{
  "mcpServers": {
    {{#each mcp.servers}}
    "{{@key}}": {
      {{#ifEq this.type "http"}}
      "type": "http",
      "url": "{{this.url}}",
      {{#if this.headers}}"headers": {{json this.headers}},{{/if}}
      {{else}}
      "type": "stdio",
      "command": "{{this.command}}",
      "args": {{json this.args}},
      {{#if this.env}}"env": {{json this.env}},{{/if}}
      {{/ifEq}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  }
}
