{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    {{#each mcp.servers}}
    "{{@key}}": {
      {{#ifEq this.type "http"}}
      "type": "remote",
      "url": "{{this.url}}"{{#if this.headers}},
      "headers": {{json this.headers}}{{/if}},
      "enabled": true
      {{else}}
      "type": "local",
      "command": ["{{this.command}}"{{#each this.args}}, {{json this}}{{/each}}],
      "enabled": true{{#if this.env}},
      "environment": {{json this.env}}{{/if}}
      {{/ifEq}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  }
}
