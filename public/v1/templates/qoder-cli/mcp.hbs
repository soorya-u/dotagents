{
  "mcpServers": {
    {{#each mcp.servers}}
    "{{@key}}": {
      {{#ifEq this.type "stdio"}}
      "type": "stdio",
      "command": "{{this.command}}",
      "args": {{json this.args}}{{#if this.env}},
      "env": {{json this.env}}{{/if}}{{#if this.cwd}},
      "cwd": {{json this.cwd}}{{/if}}{{#if this.envFile}},
      "envFile": {{json this.envFile}}{{/if}}
      {{else}}
      "type": "{{#ifEq this.type "http"}}streamable-http{{else}}sse{{/ifEq}}",
      "url": "{{this.url}}"{{#if this.headers}},
      "headers": {{json this.headers}}{{/if}}
      {{/ifEq}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  }
}
