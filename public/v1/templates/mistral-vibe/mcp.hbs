{{#each mcp.servers}}
[[mcp_servers]]
name = "{{@key}}"
{{#ifEq this.type "http"}}
transport = "http"
url = "{{this.url}}"
{{else}}
transport = "stdio"
command = "{{this.command}}"
args = {{json this.args}}
{{#if this.env}}env = { {{#each this.env}}"{{@key}}" = {{json this}}{{#unless @last}}, {{/unless}}{{/each}} }
{{/if}}{{/ifEq}}
{{/each}}
