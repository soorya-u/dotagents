{
  "mcpServers": {
    {{#each mcp.servers}}
    "{{@key}}": {
      {{#ifEq this.type "stdio"}}
      "command": "{{this.command}}",
      "args": {{json this.args}}{{#if this.env}},
      "env": {{json this.env}}{{/if}}{{#if this.cwd}},
      "cwd": {{json this.cwd}}{{/if}}{{#if this.envFile}},
      "envFile": {{json this.envFile}}{{/if}}
      {{else}}
      {{#ifEq this.type "sse"}}
      "url": "{{this.url}}"{{#if this.headers}},
      "headers": {{json this.headers}}{{/if}}
      {{else}}
      "httpUrl": "{{this.url}}"{{#if this.headers}},
      "headers": {{json this.headers}}{{/if}}
      {{/ifEq}}
      {{/ifEq}}{{#if this.enabledTools}},
      "includeTools": {{json this.enabledTools}}{{/if}}{{#if this.disabledTools}},
      "excludeTools": {{json this.disabledTools}}{{/if}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  }
}
