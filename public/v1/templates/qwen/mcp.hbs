{
  "mcpServers": {
    {{#each mcp.servers}}
    "{{@key}}": {
      {{#ifEq this.type "http"}}
      "httpUrl": "{{this.url}}"{{#if this.headers}},
      "headers": {{json this.headers}}{{/if}}
      {{else}}
      "command": "{{this.command}}",
      "args": {{json this.args}}{{#if this.env}},
      "env": {{json this.env}}{{/if}}{{#if this.cwd}},
      "cwd": {{json this.cwd}}{{/if}}{{#if this.env_file}},
      "env_file": {{json this.env_file}}{{/if}}
      {{/ifEq}}
    }{{#unless @last}},{{/unless}}
    {{/each}}
  }
}
