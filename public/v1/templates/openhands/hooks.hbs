{
  "hooks": {
    {{#each this as |eventHooks eventName|}}
    "{{eventName}}": [
      {{#each eventHooks as |h|}}
      {
        "type": "{{h.type}}"
        {{#if h.command}}, "command": "{{h.command}}"{{/if}}
        {{#if h.prompt}}, "prompt": "{{h.prompt}}"{{/if}}
        {{#if h.timeout}}, "timeout": {{timeout_to_seconds h.timeout}}{{/if}}
        {{#if h.async}}, "async": {{h.async}}{{/if}}
      }{{#unless @last}},{{/unless}}
      {{/each}}
    ]{{#unless @last}},{{/unless}}
    {{/each}}
  }
}
